# --- Secrets / local environment -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Map & routing data (large, regenerated by scripts; never commit) --------
# OSM extracts and OSRM graphs live in Docker named volumes by default.
# These patterns guard against accidental local copies.
data/
*.osm.pbf
*.osrm
*.osrm.*

# --- Research data / model artifacts (Phase 7+) ------------------------------
*.parquet
artifacts/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Next.js (Phase 6+) -----------------------------------------------
node_modules/
.next/
out/

# --- Editors / OS --------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
