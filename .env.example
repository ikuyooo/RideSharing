# Copy to .env and replace every "change-me" value before `docker compose up`.
# .env is git-ignored. Never commit real credentials.

COMPOSE_PROJECT_NAME=ridesharing

# --- PostgreSQL 16 + PostGIS 3.4 --------------------------------------------
POSTGRES_DB=ridesharing
POSTGRES_USER=ridesharing
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432

# --- Redis 7 ------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_HOST_PORT=6379

# --- OSRM (two routing engines, Section 34 of Revision 9) ---------------------
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v5.27.1
OSRM_CAR_HOST_PORT=5000
OSRM_MOTORBIKE_HOST_PORT=5001
# Max points per /table request. Section 34 calls for one matrix call of ~60-100 points.
OSRM_MAX_TABLE_SIZE=200

# --- OSM source & clipping (scripts/osm/fetch_and_clip.sh) --------------------
OSM_SOURCE_URL=https://download.geofabrik.de/asia/vietnam-latest.osm.pbf
# Northern Vietnam bbox: min_lon,min_lat,max_lon,max_lat. Covers Hanoi plus the
# 150 km service radius (max_total_service_radius_km in the baseline config).
OSM_CLIP_BBOX=104.30,19.60,107.50,22.50

# --- Backend (FastAPI) -----------------------------------------------------------
BACKEND_HOST_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
